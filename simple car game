command = ""
started = False 

while True:
    command = input ("> ").lower()
    if command == "start":
        if started:
            print ("the car already started !")
        else:
            started = True
            print ("car started... ready to go")
    elif command == "stop":
        if not started:
            print ("the car already stopped !")
        else:
            started = False 
            print("car stopped..")
    elif command == "help":
        print ('''
start - started the car
stop - stopped the car
quit - quit the game
               ''')
    elif command == "quit":
        break
    else:
        print ("i don't understand that...")
